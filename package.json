{
  "name": "blog-finmoovi",
  "type": "module",
  "version": "1.0.0",
  "description": "Blog FinMoovi - Portal de Finanças Pessoais",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "npm run validate:i18n:sync && npm run validate:slugs && npm run generate && astro build && npm run validate:schema",
    "validate:schema": "node scripts/validate-schema.js",
    "preview": "astro preview",
    "astro": "astro",
    "postbuild": "pagefind --site dist",
    "generate": "node --import tsx scripts/generate-brand-css.js && node --import tsx scripts/generate-functions-config.js && node --import tsx scripts/generate-manifest.js && node --import tsx scripts/generate-i18n-client.js",
    "validate": "node --import tsx scripts/validate-template.js",
    "validate:i18n": "npm run validate:i18n:sync && npm run validate:i18n:posts",
    "validate:i18n:sync": "node --import tsx scripts/validate-i18n-sync.js",
    "validate:i18n:posts": "node src/scripts/validacao/validar-i18n.js",
    "validate:slugs": "node scripts/validate-slug-language.js",
    "validate:capas": "node src/scripts/validacao/validar-capas.js",
    "demo-content": "node --import tsx scripts/generate-demo-content.js",
    "reset:nicho": "node --import tsx scripts/reset-nicho.js",
    "setup:web": "node --import tsx scripts/setup-web.js",
    "setup": "node --import tsx scripts/setup.js",
    "ping:sitemap": "node --import tsx scripts/ping-search-engines.js"
  },
  "dependencies": {
    "@astrojs/rss": "^4.0.18",
    "astro": "^4.16.0",
    "msedge-tts": "^2.0.7",
    "sharp": "^0.33.5"
  },
  "devDependencies": {
    "gray-matter": "^4.0.3",
    "pagefind": "^1.1.0",
    "tsx": "^4.7.0",
    "typescript": "^5.6.0"
  }
}
