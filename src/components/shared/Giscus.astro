---
import { config } from '../../site.config';

interface Props {
  term?: string;
}
const { term } = Astro.props;
// Giscus config comes from site.config.ts
const { repo, repoId, category, categoryId } = config.giscus;
const giscusEnabled = repoId && categoryId;

/**
 * OS COMENTÁRIOS SÓ CARREGAM COM AUTORIZAÇÃO — 12/08/2026 (RGPD/GDPR).
 *
 * ═══ O FURO QUE ISTO FECHA ═══
 * O Giscus é o GitHub. Até aqui o `client.js` era escrito direto no HTML, o que fazia
 * **todos os visitantes de todos os artigos ligarem-se a servidores do GitHub nos
 * Estados Unidos** — levando o endereço IP com eles — antes de qualquer escolha. Um
 * IP é dado pessoal, e isto é uma transferência para fora da UE. Era o único ponto do
 * blog onde havia mesmo um problema: o resto do site não usa cookies nem rastreio.
 *
 * ═══ COMO PASSOU A SER ═══
 * Nada é carregado na chegada. O que aparece é um cartão que **diz o que vai
 * acontecer** e um botão. A partir daí há dois caminhos, e ambos são escolha de quem
 * lê:
 *   · quem aceitou no aviso de privacidade → os comentários abrem sozinhos;
 *   · quem recusou, ou ainda não escolheu → carrega ao clicar, e o clique vale
 *     apenas para esta visita (não fica escolha nenhuma gravada às escondidas).
 *
 * ⚠️ **O `<script>` TEM DE SER CRIADO POR JAVASCRIPT.** Escrevê-lo no HTML com um
 * `hidden` à volta não serve de nada: o navegador vai buscá-lo à mesma. O que não é
 * pedido é o que não existe na página — por isso ele nasce só no momento do clique.
 */
const path = Astro.url.pathname;
const locale = path.startsWith('/en/') || path === '/en' ? 'en'
  : path.startsWith('/es/') || path === '/es' ? 'es' : 'pt';

const T = {
  pt: {
    titulo: 'Comentários',
    aviso: 'Os comentários são fornecidos pelo GitHub (Giscus). Ao carregá-los, o seu endereço IP é enviado ao GitHub, nos Estados Unidos.',
    botao: 'Carregar comentários',
    nota: 'Comentários via GitHub Discussions. Faça login com sua conta GitHub para participar.',
  },
  en: {
    titulo: 'Comments',
    aviso: 'Comments are provided by GitHub (Giscus). Loading them sends your IP address to GitHub, in the United States.',
    botao: 'Load comments',
    nota: 'Comments via GitHub Discussions. Sign in with your GitHub account to join.',
  },
  es: {
    titulo: 'Comentarios',
    aviso: 'Los comentarios los proporciona GitHub (Giscus). Al cargarlos, tu dirección IP se envía a GitHub, en Estados Unidos.',
    botao: 'Cargar comentarios',
    nota: 'Comentarios vía GitHub Discussions. Inicia sesión con tu cuenta de GitHub para participar.',
  },
}[locale];

const giscusLang = locale === 'en' ? 'en' : locale === 'es' ? 'es' : 'pt';
---

<section class="comments-section">
  <h3 class="comments-title" data-i18n="post.comments">{T.titulo}</h3>
  {giscusEnabled ? (
    <div
      id="giscus-container"
      data-repo={repo}
      data-repo-id={repoId}
      data-category={category}
      data-category-id={categoryId}
      data-lang={giscusLang}
    >
      <div class="comments-consent" id="comments-consent">
        <p class="comments-consent-text">{T.aviso}</p>
        <button type="button" id="comments-load">{T.botao}</button>
      </div>
    </div>
  ) : (
    <p class="comments-placeholder" data-i18n="post.commentsPlaceholder">
      Comentários serão ativados em breve. Volte depois!
    </p>
  )}
  <p class="comments-note" data-i18n="post.commentsNote">
    {T.nota}
  </p>
</section>

<script>
  (function () {
    const container = document.getElementById('giscus-container');
    if (!container) return;
    const cartao = document.getElementById('comments-consent');
    const botao = document.getElementById('comments-load');
    let carregado = false;

    function giscusTheme(): string {
      return document.documentElement.dataset.theme === 'light' ? 'light' : 'dark_dimmed';
    }

    function carregar() {
      if (carregado) return;
      carregado = true;
      if (cartao) cartao.remove();
      const s = document.createElement('script');
      s.src = 'https://giscus.app/client.js';
      s.async = true;
      s.crossOrigin = 'anonymous';
      const d = container!.dataset;
      s.setAttribute('data-repo', d.repo || '');
      s.setAttribute('data-repo-id', d.repoId || '');
      s.setAttribute('data-category', d.category || '');
      s.setAttribute('data-category-id', d.categoryId || '');
      s.setAttribute('data-mapping', 'pathname');
      s.setAttribute('data-strict', '0');
      s.setAttribute('data-reactions-enabled', '1');
      s.setAttribute('data-emit-metadata', '0');
      s.setAttribute('data-input-position', 'top');
      s.setAttribute('data-theme', giscusTheme());
      s.setAttribute('data-lang', d.lang || 'pt');
      s.setAttribute('data-loading', 'lazy');
      container!.appendChild(s);
    }

    botao?.addEventListener('click', carregar);

    // Quem já aceitou no aviso de privacidade não tem de clicar outra vez.
    if ((window as any).fmConsent === 'aceito') carregar();
    // E quem aceitar AGORA (com o artigo aberto) vê os comentários aparecerem.
    document.addEventListener('fm-consent', (ev) => {
      if ((ev as CustomEvent).detail?.estado === 'aceito') carregar();
    });

    // Sincroniza o tema do Giscus com o toggle dark/light do blog.
    // O iframe só aceita mudança via postMessage depois de carregado.
    function pushGiscusTheme() {
      const frame = document.querySelector<HTMLIFrameElement>('iframe.giscus-frame');
      frame?.contentWindow?.postMessage(
        { giscus: { setConfig: { theme: giscusTheme() } } },
        'https://giscus.app',
      );
    }

    addEventListener('message', (e) => {
      if (e.origin === 'https://giscus.app') pushGiscusTheme();
    });

    new MutationObserver(pushGiscusTheme).observe(document.documentElement, {
      attributes: true,
      attributeFilter: ['data-theme'],
    });
  })();
</script>

<style>
  .comments-section {
    margin-top: var(--space-12);
    padding-top: var(--space-8);
    border-top: 1px solid var(--border-muted);
  }

  .comments-title {
    font-size: var(--text-xl);
    color: var(--text-primary);
    margin-bottom: var(--space-6);
  }

  .comments-consent {
    border: 1px dashed var(--border-default);
    border-radius: var(--radius-md);
    padding: var(--space-6);
    text-align: center;
  }

  .comments-consent-text {
    font-size: var(--text-sm);
    color: var(--text-secondary);
    margin: 0 0 var(--space-4);
    line-height: 1.6;
  }

  .comments-consent button {
    font-family: inherit;
    font-weight: 700;
    font-size: var(--text-sm);
    padding: 9px 22px;
    border-radius: var(--radius-full);
    border: 1px solid var(--border-default);
    background: transparent;
    color: var(--text-primary);
    cursor: pointer;
  }

  .comments-consent button:hover { border-color: var(--accent-primary); }

  .comments-note {
    font-size: var(--text-xs);
    color: var(--text-tertiary);
    margin-top: var(--space-4);
    text-align: center;
  }

  .comments-placeholder {
    font-size: var(--text-sm);
    color: var(--text-tertiary);
    text-align: center;
    padding: var(--space-8) 0;
    border: 1px dashed var(--border-default);
    border-radius: var(--radius-md);
  }
</style>
