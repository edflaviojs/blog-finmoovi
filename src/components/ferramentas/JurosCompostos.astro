---
/**
 * Calculadora de Juros Compostos — a peça, sem página à volta.
 *
 * O ponto de virada é o que esta calculadora tem e as outras não: o mês em que
 * os juros de UM mês passam a ser maiores do que o aporte desse mês. É a ideia
 * inteira dos juros compostos reduzida a uma data — e é o argumento para um
 * portal escolher esta em vez de programar a dele.
 */
import '@/styles/ferramentas.css';
---

<div class="fm-grid">
  <div class="fm-rail">
    <div class="fm-ctrl">
      <div class="fm-ctrl-top">
        <label for="jc-inicial">Capital inicial</label>
        <div class="fm-campo"><span class="fm-fixo">R$</span><input id="jc-inicial" type="text" inputmode="numeric" autocomplete="off" /></div>
      </div>
      <input class="fm-range" id="jc-s-inicial" type="range" min="0" max="100000" step="500" aria-label="Capital inicial" />
    </div>

    <div class="fm-ctrl">
      <div class="fm-ctrl-top">
        <label for="jc-aporte">Aporte mensal</label>
        <div class="fm-campo"><span class="fm-fixo">R$</span><input id="jc-aporte" type="text" inputmode="numeric" autocomplete="off" /></div>
      </div>
      <input class="fm-range" id="jc-s-aporte" type="range" min="0" max="10000" step="50" aria-label="Aporte mensal" />
    </div>

    <div class="fm-ctrl">
      <div class="fm-ctrl-top">
        <label for="jc-taxa">Taxa de juros</label>
        <div class="fm-campo"><input id="jc-taxa" type="text" inputmode="decimal" autocomplete="off" /><span class="fm-fixo">% a.m.</span></div>
      </div>
      <input class="fm-range" id="jc-s-taxa" type="range" min="0" max="3" step="0.05" aria-label="Taxa de juros ao mês" />
    </div>

    <div class="fm-ctrl">
      <div class="fm-ctrl-top">
        <label for="jc-prazo">Prazo</label>
        <div class="fm-campo"><input id="jc-prazo" type="text" inputmode="numeric" autocomplete="off" /><span class="fm-fixo">meses</span></div>
      </div>
      <input class="fm-range" id="jc-s-prazo" type="range" min="1" max="360" step="1" aria-label="Prazo em meses" />
      <span class="fm-eco" id="jc-eco"></span>
    </div>
  </div>

  <div class="fm-saida">
    <div class="fm-heroi">
      <span class="fm-rotulo">Você terá</span>
      <strong class="fm-heroi-valor" id="jc-total">R$ 0</strong>
      <p class="fm-heroi-nota" id="jc-nota"></p>
    </div>

    <div class="fm-achado" id="jc-virada" hidden>
      <span class="fm-achado-marca" aria-hidden="true"></span>
      <div class="fm-achado-txt">
        <span class="fm-rotulo">O ponto de virada</span>
        <p id="jc-virada-frase"></p>
      </div>
    </div>

    <figure class="fm-grafico">
      <canvas id="jc-chart" role="img" aria-label="Evolução do dinheiro ao longo do tempo"></canvas>
      <figcaption class="fm-legenda">
        <span class="fm-chave" data-cor="verde">Com juros</span>
        <span class="fm-chave" data-cor="cinza">Parado na conta</span>
        <span class="fm-chave" data-cor="area">A diferença são os juros</span>
      </figcaption>
    </figure>

    <div class="fm-reparticao">
      <div class="fm-rep">
        <span class="fm-rotulo">Saiu do seu bolso</span>
        <strong class="fm-rep-valor" id="jc-investido">R$ 0</strong>
      </div>
      <div class="fm-rep bom">
        <span class="fm-rotulo">Veio dos juros</span>
        <strong class="fm-rep-valor" id="jc-juros">R$ 0</strong>
      </div>
    </div>

    <div class="fm-barra" aria-hidden="true">
      <span class="parte-a" id="jc-barra-a"></span>
      <span class="parte-b" id="jc-barra-b"></span>
    </div>

    <details class="fm-tabela-wrap">
      <summary>Ver ano a ano</summary>
      <div class="fm-tabela-scroll">
        <table class="fm-tabela">
          <thead><tr><th>Ano</th><th>Do bolso</th><th>Juros</th><th>Total</th></tr></thead>
          <tbody id="jc-tbody"></tbody>
        </table>
      </div>
    </details>
  </div>
</div>

<script>
  import { brl, $, tempoEmPalavras, campoDinheiro, campoDecimal, campoInteiro, contador, criarGrafico, token } from './ui.js';

  const grafico = criarGrafico($('jc-chart'));
  const mostraTotal = contador($('jc-total'), (v) => brl.format(v));

  const lerInicial = campoDinheiro('jc-inicial', 'jc-s-inicial', 1000, recalcular);
  const lerAporte = campoDinheiro('jc-aporte', 'jc-s-aporte', 500, recalcular);
  const lerTaxa = campoDecimal('jc-taxa', 'jc-s-taxa', 1, recalcular, 20);
  const lerPrazo = campoInteiro('jc-prazo', 'jc-s-prazo', 60, recalcular, 600);

  function recalcular() {
    const inicial = lerInicial(), aporte = lerAporte();
    const i = lerTaxa() / 100, meses = Math.max(1, lerPrazo());

    let saldo = inicial;
    const parado = [inicial], comJuros = [inicial];
    let virada = null;

    for (let m = 1; m <= meses; m++) {
      const jurosDoMes = saldo * i;
      if (virada === null && aporte > 0 && jurosDoMes > aporte) virada = m;
      saldo = saldo + jurosDoMes + aporte;
      parado.push(inicial + aporte * m);
      comJuros.push(saldo);
    }

    const investido = inicial + aporte * meses;
    const juros = saldo - investido;

    mostraTotal(saldo);
    $('jc-investido').textContent = brl.format(investido);
    $('jc-juros').textContent = brl.format(juros);
    $('jc-eco').textContent = tempoEmPalavras(meses);

    const parte = saldo > 0 ? Math.round((juros / saldo) * 100) : 0;
    $('jc-nota').innerHTML = 'em ' + tempoEmPalavras(meses) + '. <b>' + parte + '%</b> desse dinheiro veio dos juros, não do seu bolso.';

    const caixa = $('jc-virada');
    if (virada) {
      caixa.hidden = false;
      $('jc-virada-frase').innerHTML =
        'A partir do <b>mês ' + virada + '</b> (' + tempoEmPalavras(virada) + '), os juros rendem mais num mês do que os ' +
        brl.format(aporte) + ' que você deposita. Daí para a frente, quem trabalha é o dinheiro.';
    } else {
      caixa.hidden = true;
    }

    const pct = saldo > 0 ? (investido / saldo) * 100 : 100;
    $('jc-barra-a').style.width = pct + '%';
    $('jc-barra-b').style.width = (100 - pct) + '%';

    let linhas = '';
    const anos = Math.ceil(meses / 12);
    for (let a = 1; a <= anos; a++) {
      const m = Math.min(a * 12, meses);
      const inv = parado[m], tot = comJuros[m];
      const marca = (virada && Math.ceil(virada / 12) === a) ? ' class="marcada"' : '';
      linhas += '<tr' + marca + '><td>' + a + '</td><td>' + brl.format(inv) + '</td><td>' + brl.format(tot - inv) + '</td><td>' + brl.format(tot) + '</td></tr>';
    }
    $('jc-tbody').innerHTML = linhas;

    grafico.atualizar({
      series: [
        { dados: comJuros, cor: '#3fb950' },
        { dados: parado, cor: token('--text-tertiary', '#6e7681'), tracejada: true },
      ],
      areaEntre: [0, 1],
      corArea: 'rgba(63,185,80,.13)',
      marca: virada ? { i: virada, texto: 'ponto de virada' } : null,
      formatar: (v) => brl.format(v),
    });
  }

  recalcular();
</script>
