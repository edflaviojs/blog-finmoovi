---
import '@/styles/global.css';
import { config } from '../../site.config';
import { absUrl, canonicalPath } from '@/utils/url';

interface Props {
  title: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  publishedTime?: string;
  author?: string;
  keywords?: string[];
  noindex?: boolean;
  alternates?: { pt?: string; en?: string; es?: string };
  preloadImage?: string;
  preloadImageSrcset?: string;
  preloadImageSizes?: string;
}

const blogTitle = `${config.brand.name} ${config.brand.blogSuffix}`;

const {
  title,
  description = config.siteDescription.pt,
  image = '/images/og-default.png',
  type = 'website',
  publishedTime,
  author = config.content.defaultAuthor,
  keywords = config.content.defaultKeywords.pt.split(', '),
  noindex = false,
  alternates,
  preloadImage,
  preloadImageSrcset,
  preloadImageSizes
} = Astro.props;

const canonicalURL = absUrl(Astro.url.pathname);
const ogImage = new URL(image, Astro.site);
// startsWith (não só ===): a home passa "FinMoovi Blog — <sufixo descritivo>"
// para o title já nascer com 50-60 chars (recomendação de SEO); sem isso o
// título ficaria duplicado ("...Gastos | FinMoovi Blog | FinMoovi Blog").
const fullTitle = title.startsWith(blogTitle) ? title : `${title} | ${blogTitle}`;

// i18n: detect current locale and compute base path
const path = Astro.url.pathname;
let currentLocale = 'pt';
let basePath = path;
if (basePath.startsWith('/en/')) { currentLocale = 'en'; basePath = basePath.slice(3); }
else if (basePath.startsWith('/es/')) { currentLocale = 'es'; basePath = basePath.slice(3); }
else if (basePath === '/en') { currentLocale = 'en'; basePath = '/'; }
else if (basePath === '/es') { currentLocale = 'es'; basePath = '/'; }

const htmlLang = currentLocale === 'pt' ? 'pt-BR' : currentLocale === 'es' ? 'es' : 'en';
const hrefPt = absUrl(basePath);
const hrefEn = absUrl('/en' + (basePath === '/' ? '' : basePath));
const hrefEs = absUrl('/es' + (basePath === '/' ? '' : basePath));

// Only emit hreflang for pages that exist in all locales
//
// A comparação TEM de ser feita na forma normalizada: com build format
// 'directory', Astro.url.pathname vem COM barra final ('/glossario/'), então
// comparar contra '/glossario' nunca casava e essas páginas saíam com ZERO
// hreflang nos 3 idiomas. A lista abaixo é a forma canônica (canonicalPath),
// e só ela — nenhuma rota nova entra por causa desta correção.
const I18N_BASE_PATHS = ['/', '/glossario/', '/ferramentas/', '/sobre/'];
const hasI18nVersion = alternates || I18N_BASE_PATHS.includes(canonicalPath(basePath));
const finalHrefPt = alternates?.pt ? absUrl(alternates.pt) : hrefPt;
const finalHrefEn = alternates?.en ? absUrl(alternates.en) : hrefEn;
const finalHrefEs = alternates?.es ? absUrl(alternates.es) : hrefEs;
const ogLocale = currentLocale === 'pt' ? 'pt_BR' : currentLocale === 'es' ? 'es_ES' : 'en_US';
---

<!DOCTYPE html>
<html lang={htmlLang}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="generator" content={Astro.generator} />

  <!-- SEO -->
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  <meta name="keywords" content={keywords.join(', ')} />
  <meta name="author" content={author} />
  <link rel="canonical" href={canonicalURL} />
  {noindex
    ? <meta name="robots" content="noindex, nofollow" />
    : <meta name="robots" content="max-image-preview:large, max-snippet:-1, max-video-preview:-1" />}

  <!-- hreflang (T8: só emite se o blog tem 2+ idiomas configurados) -->
  {hasI18nVersion && config.locales.length > 1 && (
    <>
      {config.locales.includes('pt') && <link rel="alternate" hreflang="pt" href={finalHrefPt} />}
      {config.locales.includes('en') && <link rel="alternate" hreflang="en" href={finalHrefEn} />}
      {config.locales.includes('es') && <link rel="alternate" hreflang="es" href={finalHrefEs} />}
      <link rel="alternate" hreflang="x-default" href={finalHrefPt} />
    </>
  )}

  <!-- Open Graph -->
  <meta property="og:type" content={type} />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="750" />
  <meta property="og:image:alt" content={title} />
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:site_name" content={blogTitle} />
  <meta property="og:locale" content={ogLocale} />
  {publishedTime && <meta property="article:published_time" content={publishedTime} />}

  <!-- Twitter -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={fullTitle} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage} />

  <!-- Preconnect: Cloudflare Web Analytics (reduz latência do beacon) -->
  <link rel="preconnect" href="https://static.cloudflareinsights.com" crossorigin />

  <!-- Preload da imagem LCP (herói/capa) — inicia o download antes de descobrir o <img> -->
  {preloadImage && (
    <link
      rel="preload"
      as="image"
      href={preloadImage}
      imagesrcset={preloadImageSrcset}
      imagesizes={preloadImageSizes}
      fetchpriority="high"
    />
  )}

  <!-- Fonts (self-hosted for performance) -->
  <link rel="preload" href="/fonts/inter-latin-400.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="preload" href="/fonts/inter-latin-700.woff2" as="font" type="font/woff2" crossorigin />

  <!-- Favicon -->
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

  <!-- RSS -->
  <link rel="alternate" type="application/rss+xml" title={`${blogTitle} (PT)`} href="/rss.xml" />
  <link rel="alternate" type="application/rss+xml" title={`${blogTitle} (EN)`} href="/en/rss.xml" />
  <link rel="alternate" type="application/rss+xml" title={`${blogTitle} (ES)`} href="/es/rss.xml" />

  <!-- PWA -->
  <link rel="manifest" href="/manifest.json" />
  <meta name="theme-color" content={config.brand.colors.background || '#0d1117'} />

  <!-- Organization Schema -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Organization",
    "name": config.brand.name,
    "url": `https://${config.brand.domains.main}`,
    "logo": `${config.siteUrl}/images/og-default.png`,
    "sameAs": [config.siteUrl],
    "description": config.siteDescription.pt
  })} />

  <!-- Theme (inline para evitar request render-blocking e flash de tema) -->
  <script is:inline>
    (function() {
      var saved = null;
      try { saved = localStorage.getItem('fm-theme'); } catch(e) {}
      var prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
      var theme = saved || (prefersDark ? 'dark' : 'light');
      document.documentElement.setAttribute('data-theme', theme);

      window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', function(e) {
        var hasSaved = false;
        try { hasSaved = !!localStorage.getItem('fm-theme'); } catch(ex) {}
        if (!hasSaved) {
          document.documentElement.setAttribute('data-theme', e.matches ? 'dark' : 'light');
        }
      });
    })();
  </script>
</head>
<body>
  <slot />
  <script is:inline src="/scripts/i18n.js?v=2" defer></script>
  <!--
    Cloudflare Web Analytics — medição SEM cookies e sem identificar ninguém.

    ⚠️ **ELE RESPEITA QUEM RECUSOU, E É POR ISSO QUE DEIXOU DE SER UMA `<script src>`
    DIRETA** (12/08/2026). O aviso de privacidade tem um botão "Recusar"; um botão que
    não desliga nada é decoração, e decoração é exatamente o que as autoridades
    europeias tratam como consentimento de fachada. Escrito no HTML, o beacon era
    pedido pelo navegador antes de qualquer código nosso correr — dava para o apagar
    da página, mas ele voltava na página seguinte.

    Agora nasce por JavaScript, e só quando a escolha guardada não é "recusado". Quem
    nunca escolheu continua a ser medido: a medição é anónima e agregada, e essa é a
    base legítima que a Política de Privacidade declara. Quem recusou fica de fora em
    todas as páginas, não só naquela onde carregou no botão.
  -->
  {config.analytics.cloudflareBeaconToken && (
    <script is:inline define:vars={{ token: config.analytics.cloudflareBeaconToken }}>
      (function () {
        try {
          var d = JSON.parse(localStorage.getItem('fm-consent') || 'null');
          if (d && d.estado === 'recusado') return;
        } catch (e) { /* sem armazenamento — vale a medição anónima */ }
        var s = document.createElement('script');
        s.defer = true;
        s.src = 'https://static.cloudflareinsights.com/beacon.min.js';
        s.setAttribute('data-cf-beacon', JSON.stringify({ token: token }));
        document.body.appendChild(s);
      })();
    </script>
  )}
</body>
</html>
