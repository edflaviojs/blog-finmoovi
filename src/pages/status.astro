---
import BaseLayout from '@layouts/BaseLayout.astro';
import Header from '@components/header/Header.astro';
import Footer from '@components/footer/Footer.astro';
import { readdirSync, readFileSync, existsSync } from 'node:fs';
import { join } from 'node:path';
import { looksWrongLanguage } from '../scripts/lib/lang-guard.js';

// Página INTERNA de status das automações (histórico de 30 dias do Relatório do Dia).
// noindex + fora do sitemap (sitemap-index.xml.ts é curado à mão e NÃO inclui /status)
// + fora do Pagefind (indexação é opt-in via data-pagefind-body, que esta página não tem).
// Lê os snapshots gerados pelo digest-diario-conteudo.js em BUILD TIME.

interface Snapshot {
  date: string;
  counts: { content: number; videos: number; pins: number; failures: number; runs: number };
  failures: { name: string; htmlUrl: string; timeLisbon: string }[];
  content: { title: string; url: string; label: string; locale: string; category?: string }[];
  videos: { slug: string; videoId: string; title?: string; timeLisbon?: string }[];
  pins: { slug: string; title?: string; pinId: string; postUrl?: string; timeLisbon?: string }[];
  runsSummary: { name: string; count: number; ok: number; fail: number; firstTimeLisbon: string }[];
  emails: { name: string; timeLisbon: string }[];
  pendencias: string[];
  agenda: { name: string; times: string[] }[];
}

const relDir = join(process.cwd(), '.github/data/relatorios');
let days: Snapshot[] = [];
if (existsSync(relDir)) {
  days = readdirSync(relDir)
    .filter(f => /^\d{4}-\d{2}-\d{2}\.json$/.test(f))
    .sort()
    .reverse()
    .slice(0, 30)
    .map(f => {
      try {
        return JSON.parse(readFileSync(join(relDir, f), 'utf-8')) as Snapshot;
      } catch {
        return null;
      }
    })
    .filter((s): s is Snapshot => s !== null);
}

// Pendências atuais (PENDENCIAS.md, parseado em build — mesma regra do digest).
let pendencias: string[] = [];
const pendFile = join(process.cwd(), 'PENDENCIAS.md');
if (existsSync(pendFile)) {
  pendencias = readFileSync(pendFile, 'utf-8')
    .split('\n')
    .map(l => l.trim())
    .filter(l => /^-\s*\[\s\]\s+/.test(l))
    .map(l => l.replace(/^-\s*\[\s\]\s+/, '')
      .replace(/\*\*(.+?)\*\*/g, '$1')
      .replace(/\*(.+?)\*/g, '$1')
      .replace(/`(.+?)`/g, '$1')
      .replace(/\[(.+?)\]\((.+?)\)/g, '$1'));
}

const fmtDate = (iso: string) => {
  const [y, m, d] = iso.split('-');
  return `${d}/${m}/${y}`;
};

const localeFlag: Record<string, string> = { pt: '🇧🇷', en: '🇺🇸', es: '🇪🇸' };

// ── Fila de keywords (.github/data/keyword-queue.json, lida em BUILD TIME
//    como os snapshots; arquivo ausente/corrompido → seção com estado vazio) ──
interface QueueEntry {
  keyword: string;
  category: string | null;
  priority: number;
  source: string;
  status: string;
  addedAt: string;
  usedAt?: string;
  usedBy?: string;
  reason?: string;
}

const queueFile = join(process.cwd(), '.github/data/keyword-queue.json');
let queueEntries: QueueEntry[] = [];
let queueUpdatedAt: string | null = null;
if (existsSync(queueFile)) {
  try {
    const q = JSON.parse(readFileSync(queueFile, 'utf-8'));
    if (Array.isArray(q?.entries)) queueEntries = q.entries;
    queueUpdatedAt = q?.updatedAt || null;
  } catch { /* fila ilegível → estado vazio */ }
}

const SOURCE_LABELS: [string, string][] = [
  ['manual', '✍️ Manuais (prioridade 1)'],
  ['gsc-gap', '🕳️ Lacunas do GSC (prioridade 2)'],
  ['autocomplete', '🔮 Autocomplete (prioridade 3)'],
];
const pendingBySource = SOURCE_LABELS.map(([source, label]) => ({
  source,
  label,
  items: queueEntries.filter(e => e.status === 'pending' && e.source === source),
}));
const pendingOther = queueEntries.filter(
  e => e.status === 'pending' && !SOURCE_LABELS.some(([s]) => s === e.source)
);
const totalPending = queueEntries.filter(e => e.status === 'pending').length;
const usedRecent = queueEntries
  .filter(e => e.status === 'used')
  .sort((a, b) => String(b.usedAt || '').localeCompare(String(a.usedAt || '')))
  .slice(0, 10);
const skippedRecent = queueEntries
  .filter(e => e.status === 'skipped')
  .sort((a, b) => String(b.addedAt || '').localeCompare(String(a.addedAt || '')))
  .slice(0, 10);

const REASON_LABELS: Record<string, string> = {
  'ja-coberto': 'já coberta por post',
  'coberto-glossario': 'já coberta pelo glossário',
  'descartada-revisao': 'descartada na revisão',
};
const reasonLabel = (r?: string) => (r && REASON_LABELS[r]) || r || 'sem motivo registrado';
const fmtIsoDay = (iso?: string) => (iso ? fmtDate(iso.split('T')[0]) : '—');

// ── Oportunidades Reddit (.github/data/reddit-opportunities.json) ──
interface RedditOpp {
  foundAt: string;
  redditUrl: string;
  subreddit: string;
  title: string;
  matchedKeywords?: string[];
  suggestedBlogPost?: string;
}

const redditFile = join(process.cwd(), '.github/data/reddit-opportunities.json');
let redditOpps: RedditOpp[] = [];
if (existsSync(redditFile)) {
  try {
    const parsed = JSON.parse(readFileSync(redditFile, 'utf-8'));
    if (Array.isArray(parsed)) {
      redditOpps = parsed
        .slice()
        .sort((a, b) => String(b.foundAt || '').localeCompare(String(a.foundAt || '')))
        .slice(0, 10);
    }
  } catch { /* arquivo ilegível → estado vazio */ }
}

// ── Caixa de entrada das redes (.github/data/comentarios-redes.json) ──
//
// 🔴 Só entram aqui os comentários que ESPERAM pelo dono. Quem escreveu FINMOOVI a pedir
// o app já foi respondido sozinho pelo robô e não aparece — o painel é a lista de trabalho,
// não o histórico. Ver `src/scripts/redes/comentarios-redes.js`.
//
// ⚠️ Instagram e YouTube não estão aqui de propósito: os dois têm robô próprio a responder.
interface ComentarioRede {
  id: string;
  rede: string;
  autor: string;
  texto: string;
  quando?: string;
  link: string;
  rascunho: string;
  ehQueixa?: boolean;
  motivo?: string;
}

const comentariosFile = join(process.cwd(), '.github/data/comentarios-redes.json');
let comentariosRedes: ComentarioRede[] = [];
let comentariosAtualizadoEm = '';
if (existsSync(comentariosFile)) {
  try {
    const parsed = JSON.parse(readFileSync(comentariosFile, 'utf-8'));
    comentariosAtualizadoEm = String(parsed?.atualizadoEm || '');
    if (Array.isArray(parsed?.comentarios)) {
      comentariosRedes = parsed.comentarios
        .slice()
        // 🔑 As queixas primeiro, e só depois por data. São elas que estragam se ficarem
        // à espera — um elogio pode esperar um dia, uma reclamação não.
        .sort((a: ComentarioRede, b: ComentarioRede) => {
          if (Boolean(a.ehQueixa) !== Boolean(b.ehQueixa)) return a.ehQueixa ? -1 : 1;
          return String(b.quando || '').localeCompare(String(a.quando || ''));
        })
        .slice(0, 20);
    }
  } catch { /* arquivo ilegível → estado vazio */ }
}
const queixasAbertas = comentariosRedes.filter(c => c.ehQueixa).length;

// ── Trava de tradução (lang-guard) — scan barato em BUILD TIME (só regex)
//    sobre todos os en-*/es-* de posts e glossário ──
const langGuardDirs: [string, string][] = [
  [join(process.cwd(), 'src/content/posts'), 'posts'],
  [join(process.cwd(), 'src/content/glossario'), 'glossario'],
];
const suspectTranslations: string[] = [];
for (const [dir, label] of langGuardDirs) {
  if (!existsSync(dir)) continue;
  for (const f of readdirSync(dir).filter(f => /^(en|es)-.+\.md$/.test(f))) {
    try {
      const raw = readFileSync(join(dir, f), 'utf-8');
      const m = raw.match(/^---\r?\n[\s\S]*?\r?\n---\r?\n?([\s\S]*)$/);
      const body = m ? m[1] : raw;
      const check = looksWrongLanguage(body, f.startsWith('en-') ? 'en' : 'es');
      if (check.wrong) suspectTranslations.push(`${label}/${f}`);
    } catch { /* arquivo ilegível não derruba o build da /status */ }
  }
}

const daysAgo = (d: string) => {
  const diff = Math.floor((Date.now() - new Date(`${d}T00:00:00Z`).getTime()) / 86400000);
  if (!Number.isFinite(diff) || diff < 0) return '—';
  if (diff === 0) return 'hoje';
  return diff === 1 ? 'há 1 dia' : `há ${diff} dias`;
};
---

<BaseLayout
  title="Status das Automações"
  description="Histórico interno do Relatório do Dia (últimos 30 dias)."
  noindex={true}
>
  <Header />

  <main class="status-page">
    <div class="container">
      <header class="status-header">
        <h1 class="status-title">📊 Status das Automações</h1>
        <p class="status-subtitle">
          Histórico do Relatório do Dia — últimos 30 dias (horário de Lisboa).
          Atualiza a cada envio do digest (~6h40).
        </p>
        <p
          class={`translations-line${suspectTranslations.length > 0 ? ' warn' : ''}`}
          title={suspectTranslations.length > 0 ? suspectTranslations.slice(0, 30).join(', ') : 'lang-guard: todos os corpos EN/ES passaram na checagem de idioma (build time)'}
        >
          {suspectTranslations.length === 0
            ? '🌐 Traduções: OK'
            : `⚠️ ${suspectTranslations.length} arquivo${suspectTranslations.length === 1 ? '' : 's'} com tradução suspeita`}
        </p>
      </header>

      <section class="status-panel panel-enviar">
        <h2>📥 Enviar keywords</h2>
        <p class="panel-hint">
          Entram no <code>data/keywords-manuais.csv</code> com prioridade 1; o workflow
          sincroniza a fila automaticamente após o envio.
        </p>
        <form id="kw-form">
          <textarea
            id="kw-input"
            rows="4"
            placeholder={'Separe por vírgula ou uma por linha (máx. 50). Ex.:\ncomo montar reserva de emergência\ncdb ou tesouro direto, orçamento familiar simples'}
            required
          ></textarea>
          <div class="kw-row">
            <select id="kw-cat" aria-label="Categoria">
              <option value="">Categoria: qualquer</option>
              <option value="dicas">dicas</option>
              <option value="investimentos">investimentos</option>
              <option value="orcamento">orcamento</option>
              <option value="glossario">Glossário (termo)</option>
            </select>
            <input
              type="password"
              id="kw-key"
              placeholder="Senha de acesso"
              autocomplete="off"
              required
            />
            <button type="submit" id="kw-btn">Enviar</button>
          </div>
          <p id="kw-feedback" class="kw-feedback" hidden></p>
        </form>
      </section>

      <!--
        ♦ 06/08/2026 — A OPORTUNIDADE DO DONO (IMPL20 §60).
        O tema que ele viu e quer JÁ: entra à cabeça da fila e é o próximo a ser feito.
        ⚠️ Não produz nada aqui — só arruma a fila. Quem faz o vídeo é o robô de sempre,
        à hora de sempre; um botão que dispara uma produção é um botão que gasta 36
        minutos de máquina por engano.
      -->
      <section class="status-panel panel-oportunidade">
        <h2>⭐ Oportunidade do dono</h2>
        <p class="panel-hint">
          Viu um tema que vale a pena? Ele passa <strong>à frente da fila</strong> e é o
          próximo a ser feito. Depois a fila segue como estava.
        </p>
        <form id="op-form">
          <label class="op-rotulo" for="op-tema">A ideia</label>
          <textarea
            id="op-tema"
            rows="3"
            placeholder="Ex.: pagar a fatura ANTES do fecho dá mais 30 dias sem juros"
            required
          ></textarea>
          <!-- ⚠️ O contador aparece ANTES de o dono carregar no botão. Ele escreveu um
               tema comprido e só descobriu o limite depois de tentar enviar — o aviso
               tem de estar onde ele está a olhar, não depois. -->
          <span id="op-contador" class="op-contador">0 / 1000 letras</span>
          <label class="op-rotulo" for="op-titulo">O título <span id="op-titulo-nota">(opcional — a IA escreve)</span></label>
          <input
            type="text"
            id="op-titulo"
            placeholder="Deixe vazio e a IA escreve o título"
            autocomplete="off"
          />
          <div class="kw-row">
            <select id="op-formato" aria-label="Onde entra">
              <option value="short">Short (sai na madrugada seguinte)</option>
              <option value="longo">Vídeo longo (sai no domingo seguinte)</option>
              <option value="ambos">Os dois</option>
            </select>
            <input
              type="password"
              id="op-senha"
              placeholder="Senha de acesso"
              autocomplete="off"
              required
            />
            <button type="submit" id="op-btn">Furar a fila</button>
          </div>
          <p id="op-feedback" class="kw-feedback" hidden></p>
        </form>
      </section>

      <section class="status-panel panel-comentarios">
        <h2>💬 Comentários pendentes</h2>
        <p class="panel-hint">
          Comentários do blog nascem <code>pending</code> e só aparecem no site depois
          de aprovados aqui (mesma senha do envio de keywords).
        </p>
        <form id="cm-mod-form">
          <div class="kw-row">
            <input
              type="password"
              id="cm-mod-key"
              placeholder="Senha de acesso"
              autocomplete="off"
              required
            />
            <button type="submit" id="cm-mod-btn">Carregar pendentes</button>
          </div>
        </form>
        <p id="cm-mod-feedback" class="kw-feedback" hidden></p>
        <div id="cm-mod-list" class="cm-mod-list"></div>
      </section>

      <section class="status-panel panel-fila">
        <h2>🗂️ Fila de keywords <span class="count">({totalPending} pendente{totalPending === 1 ? '' : 's'})</span></h2>
        {queueEntries.length === 0 ? (
          <p class="empty-line">Fila ainda vazia — envie keywords acima ou aguarde a próxima sincronização. 🌱</p>
        ) : (
          <>
            {queueUpdatedAt && (
              <p class="panel-hint">Última sincronização: {fmtIsoDay(queueUpdatedAt)}</p>
            )}
            {pendingBySource.map(group => (
              <div class="fila-grupo">
                <h3>{group.label} <span class="count">({group.items.length})</span></h3>
                {group.items.length === 0 ? (
                  <p class="empty-line">Nenhuma.</p>
                ) : (
                  <ul>
                    {group.items.map(e => (
                      <li>
                        {e.keyword}
                        {e.category && <span class="tag">{e.category}</span>}
                      </li>
                    ))}
                  </ul>
                )}
              </div>
            ))}
            {pendingOther.length > 0 && (
              <div class="fila-grupo">
                <h3>🧩 Outras fontes <span class="count">({pendingOther.length})</span></h3>
                <ul>
                  {pendingOther.map(e => (
                    <li>
                      {e.keyword}
                      <span class="tag">{e.source}</span>
                      {e.category && <span class="tag">{e.category}</span>}
                    </li>
                  ))}
                </ul>
              </div>
            )}
            <div class="fila-grupo">
              <h3>✅ Últimas usadas <span class="count">({usedRecent.length})</span></h3>
              {usedRecent.length === 0 ? (
                <p class="empty-line">Nenhuma ainda.</p>
              ) : (
                <ul>
                  {usedRecent.map(e => (
                    <li>
                      {e.keyword}
                      {e.usedBy && <span class="tag">{e.usedBy}</span>}
                      <span class="time">{fmtIsoDay(e.usedAt)}</span>
                    </li>
                  ))}
                </ul>
              )}
            </div>
            <div class="fila-grupo">
              <h3>⏭️ Últimas puladas <span class="count">({skippedRecent.length})</span></h3>
              {skippedRecent.length === 0 ? (
                <p class="empty-line">Nenhuma.</p>
              ) : (
                <ul>
                  {skippedRecent.map(e => (
                    <li>
                      {e.keyword}
                      <span class="tag">{reasonLabel(e.reason)}</span>
                    </li>
                  ))}
                </ul>
              )}
            </div>
          </>
        )}
      </section>

      <section class="status-panel panel-redes">
        <h2>
          📥 Comentários das REDES à sua espera <span class="count">({comentariosRedes.length})</span>
          {queixasAbertas > 0 && <span class="tag alerta">{queixasAbertas} reclamação(ões)</span>}
        </h2>
        <p class="panel-hint">
          Facebook, Threads, Bluesky e Telegram numa lista só, 3× por dia. Quem escreveu
          <strong> FINMOOVI</strong> pedindo o app já foi respondido sozinho e não aparece aqui.
          <br />
          <em>Instagram e YouTube têm robô próprio e ficam de fora.</em>
          {comentariosAtualizadoEm && <> · última olhada: {fmtIsoDay(comentariosAtualizadoEm)}</>}
        </p>
        {comentariosRedes.length === 0 ? (
          <p class="empty-line">Nenhum comentário à espera. O robô segue olhando 3× por dia. 👀</p>
        ) : (
          <ul class="lista-comentarios">
            {comentariosRedes.map(c => (
              <li class={c.ehQueixa ? 'comentario queixa' : 'comentario'}>
                <div class="cabeca">
                  <span class="tag">{c.rede}</span>
                  <span class="autor">@{c.autor}</span>
                  {c.ehQueixa && <span class="tag alerta">reclamação</span>}
                  <span class="time">{c.quando ? daysAgo(c.quando) : ''}</span>
                </div>
                <p class="dito">{c.texto}</p>
                {/* 🔑 O rascunho é uma SUGESTÃO. Nada daqui sai sozinho — ver o robô. */}
                <p class="rascunho"><strong>Resposta sugerida:</strong> {c.rascunho}</p>
                <a href={c.link} target="_blank" rel="noopener noreferrer nofollow">responder lá ↗</a>
              </li>
            ))}
          </ul>
        )}
      </section>

      <section class="status-panel panel-reddit">
        <h2>💬 Oportunidades Reddit <span class="count">({redditOpps.length})</span></h2>
        <p class="panel-hint">
          O monitor roda diariamente às 7h UTC; responder é manual — cada item traz o
          post do blog sugerido para usar como referência na resposta.
        </p>
        {redditOpps.length === 0 ? (
          <p class="empty-line">Nenhuma oportunidade nos últimos 30 dias. O monitor segue vigiando. 👀</p>
        ) : (
          <ul>
            {redditOpps.map(o => (
              <li>
                <a href={o.redditUrl} target="_blank" rel="noopener noreferrer nofollow">{o.title}</a>
                <span class="tag">r/{o.subreddit}</span>
                <span class="time">{daysAgo(o.foundAt)}</span>
                {o.suggestedBlogPost && (
                  <a class="sugestao" href={o.suggestedBlogPost} target="_blank" rel="noopener noreferrer">post sugerido ↗</a>
                )}
              </li>
            ))}
          </ul>
        )}
      </section>

      <section class="status-pendencias">
        <h2>📋 Pendências abertas <span class="count">({pendencias.length})</span></h2>
        {pendencias.length === 0 ? (
          <p class="empty-line">Nenhuma pendência registrada. 🎉</p>
        ) : (
          <ul>
            {pendencias.map(p => <li>☐ {p}</li>)}
          </ul>
        )}
      </section>

      {days.length === 0 ? (
        <div class="status-empty">
          <p class="status-empty-icon">🌱</p>
          <p class="status-empty-title">Ainda sem histórico</p>
          <p class="status-empty-text">
            O primeiro snapshot aparece aqui após o próximo envio do Relatório do Dia (~6h40 de Lisboa).
          </p>
        </div>
      ) : (
        <div class="status-days">
          {days.map(day => (
            <article class={`status-card${(day.counts?.failures ?? 0) > 0 ? ' has-failures' : ''}`}>
              <header class="card-head">
                <h2 class="card-date">
                  {(day.counts?.failures ?? 0) > 0 ? '❌' : '✅'} {fmtDate(day.date)}
                </h2>
                <div class="card-counters">
                  <span title="Conteúdos publicados">📝 {day.counts?.content ?? 0}</span>
                  <span title="Vídeos YouTube">🎬 {day.counts?.videos ?? 0}</span>
                  <span title="Pins Pinterest">📌 {day.counts?.pins ?? 0}</span>
                  <span title="Workflows executados">⚙️ {day.counts?.runs ?? 0}</span>
                  <span class={(day.counts?.failures ?? 0) > 0 ? 'fail' : ''} title="Falhas">
                    🚨 {day.counts?.failures ?? 0}
                  </span>
                </div>
              </header>

              {(day.failures?.length ?? 0) > 0 && (
                <ul class="failures">
                  {day.failures.map(f => (
                    <li>
                      <a href={f.htmlUrl} target="_blank" rel="noopener noreferrer">❌ {f.name}</a>
                      <span class="time">{f.timeLisbon}</span>
                    </li>
                  ))}
                </ul>
              )}

              {(day.content?.length ?? 0) > 0 && (
                <details>
                  <summary>📝 Conteúdo publicado ({day.content.length})</summary>
                  <ul>
                    {day.content.map(c => (
                      <li>
                        <a href={c.url} target="_blank" rel="noopener noreferrer">
                          {localeFlag[c.locale] || ''} {c.title}
                        </a>
                        {c.label && <span class="tag">{c.label}</span>}
                        {c.category && <span class="tag">{c.category}</span>}
                      </li>
                    ))}
                  </ul>
                </details>
              )}

              {(day.videos?.length ?? 0) > 0 && (
                <details>
                  <summary>🎬 Vídeos YouTube ({day.videos.length})</summary>
                  <ul>
                    {day.videos.map(v => (
                      <li>
                        <a href={`https://youtu.be/${v.videoId}`} target="_blank" rel="noopener noreferrer">
                          ▶️ {v.title || v.slug}
                        </a>
                        {v.timeLisbon && <span class="time">{v.timeLisbon}</span>}
                      </li>
                    ))}
                  </ul>
                </details>
              )}

              {(day.pins?.length ?? 0) > 0 && (
                <details>
                  <summary>📌 Pins Pinterest ({day.pins.length})</summary>
                  <ul>
                    {day.pins.map(p => (
                      <li>
                        <a href={`https://www.pinterest.com/pin/${p.pinId}/`} target="_blank" rel="noopener noreferrer">
                          📌 {p.title || p.slug}
                        </a>
                        {p.timeLisbon && <span class="time">{p.timeLisbon}</span>}
                      </li>
                    ))}
                  </ul>
                </details>
              )}

              {(day.runsSummary?.length ?? 0) > 0 && (
                <details>
                  <summary>⚙️ Workflows ({day.runsSummary.length})</summary>
                  <ul>
                    {day.runsSummary.map(r => (
                      <li>
                        <span class="time">{r.firstTimeLisbon}</span> {r.name}
                        <span class="tag">{r.count}× · {r.ok} ✅{r.fail > 0 ? ` · ${r.fail} ❌` : ''}</span>
                      </li>
                    ))}
                  </ul>
                </details>
              )}
            </article>
          ))}
        </div>
      )}
    </div>
  </main>

  <Footer />
</BaseLayout>

<script>
  /**
   * ♦ 06/08/2026 — A OPORTUNIDADE DO DONO → POST /api/oportunidade.
   * ⚠️ O título é EXIGIDO no vídeo longo, e o aviso aparece aqui, ao mudar a escolha —
   * não depois de carregar no botão. O robô que publica recusa-se a subir um vídeo longo
   * sem título, e descobrir isso de madrugada custa uma semana sem vídeo.
   */
  {
    const f = document.getElementById('op-form');
    const tema = document.getElementById('op-tema');
    const titulo = document.getElementById('op-titulo');
    const formato = document.getElementById('op-formato');
    const senha = document.getElementById('op-senha');
    const botao = document.getElementById('op-btn');
    const aviso = document.getElementById('op-feedback');

    const dizer = (msg, ok) => {
      if (!aviso) return;
      aviso.textContent = msg;
      aviso.classList.toggle('ok', ok);
      aviso.classList.toggle('err', !ok);
      aviso.hidden = false;
    };

    /**
     * ⚠️ **O TETO TEM DE SER O MESMO DOS DOIS LADOS.** Este número está também em
     * `functions/api/_oportunidade-fila.js`. Se um dia se afastarem, o dono escreve um
     * tema que a página aceita e o servidor recusa — e a culpa parece ser dele.
     */
    const MAX_TEMA = 1000;
    const contador = document.getElementById('op-contador');
    const contar = () => {
      if (!contador || !tema) return;
      const n = tema.value.trim().length;
      contador.textContent = `${n} / ${MAX_TEMA} letras`;
      contador.classList.toggle('perto', n > MAX_TEMA * 0.9 && n <= MAX_TEMA);
      contador.classList.toggle('passou', n > MAX_TEMA);
    };
    if (tema) tema.addEventListener('input', contar);
    contar();

    const exigeTitulo = () => formato && formato.value !== 'short';
    const nota = document.getElementById('op-titulo-nota');
    const acertarTitulo = () => {
      if (!titulo) return;
      titulo.required = exigeTitulo();
      titulo.placeholder = exigeTitulo()
        ? 'Escreva o título exato, entre 20 e 70 letras'
        : 'Deixe vazio e a IA escreve o título';
      if (nota) {
        nota.textContent = exigeTitulo()
          ? '(obrigatório — 20 a 70 letras)'
          : '(opcional — a IA escreve)';
        nota.classList.toggle('exigido', exigeTitulo());
      }
    };
    if (formato) formato.addEventListener('change', acertarTitulo);
    acertarTitulo();

    if (f) {
      f.addEventListener('submit', async (ev) => {
        ev.preventDefault();
        const t = tema.value.trim();
        const tit = titulo.value.trim();
        if (t.length < 10) return dizer('Escreva a ideia numa frase (pelo menos 10 letras).', false);
        if (t.length > MAX_TEMA) return dizer(`A ideia tem ${t.length} letras — o máximo são ${MAX_TEMA}. Corte um bocado.`, false);
        if (exigeTitulo() && (tit.length < 20 || tit.length > 70)) {
          return dizer('O vídeo longo precisa de um título entre 20 e 70 letras — é ele que fica na lista do canal para sempre.', false);
        }
        botao.disabled = true;
        botao.textContent = 'A registar...';
        try {
          const res = await fetch('/api/oportunidade', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ senha: senha.value, tema: t, titulo: tit, formato: formato.value }),
          });
          const d = await res.json().catch(() => ({}));
          if (res.ok && d.ok) {
            dizer(`⭐ ${d.mensagem || 'Registado.'}`, true);
            tema.value = '';
            titulo.value = '';
          } else {
            dizer(d.erro || `Não deu para registar (${res.status}).`, false);
          }
        } catch (e) {
          dizer(`Não deu para registar: ${e.message}`, false);
        } finally {
          botao.disabled = false;
          botao.textContent = 'Furar a fila';
        }
      });
    }
  }

  // Envio de keywords → POST /api/keywords (Cloudflare Pages Function).
  const form = document.getElementById('kw-form');
  const input = document.getElementById('kw-input');
  const cat = document.getElementById('kw-cat');
  const key = document.getElementById('kw-key');
  const btn = document.getElementById('kw-btn');
  const feedback = document.getElementById('kw-feedback');

  function showFeedback(msg, ok) {
    if (!feedback) return;
    feedback.textContent = msg;
    feedback.classList.toggle('ok', ok);
    feedback.classList.toggle('err', !ok);
    feedback.hidden = false;
  }

  if (form) {
    form.addEventListener('submit', async (ev) => {
      ev.preventDefault();
      if (!input.value.trim() || !key.value) return;
      btn.disabled = true;
      btn.textContent = 'Enviando...';
      try {
        const res = await fetch('/api/keywords', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            accessKey: key.value,
            keywords: input.value,
            categoria: cat.value,
          }),
        });
        let data = {};
        try { data = await res.json(); } catch { /* resposta sem JSON */ }
        if (res.ok) {
          showFeedback(
            `✅ ${data.sent ?? '?'} keyword(s) enviadas! O CSV já foi commitado; a fila atualiza em ~2-3 min, ` +
            'depois que o workflow keywords-manuais rodar (esta página mostra a fila do último build).',
            true
          );
          input.value = '';
        } else {
          showFeedback(`❌ ${data.error || `Erro ${res.status} — tente novamente.`}`, false);
        }
      } catch {
        showFeedback('❌ Falha de rede — verifique a conexão e tente de novo.', false);
      } finally {
        btn.disabled = false;
        btn.textContent = 'Enviar';
      }
    });
  }
</script>

<script>
  // Moderação de comentários → GET/PATCH /api/comments (Cloudflare Pages Function).
  // Conteúdo dos leitores entra no DOM SEMPRE via textContent (nunca innerHTML).
  const modForm = document.getElementById('cm-mod-form') as HTMLFormElement | null;
  const modKey = document.getElementById('cm-mod-key') as HTMLInputElement | null;
  const modBtn = document.getElementById('cm-mod-btn') as HTMLButtonElement | null;
  const modFeedback = document.getElementById('cm-mod-feedback');
  const modList = document.getElementById('cm-mod-list');

  function modShowFeedback(msg: string, ok: boolean) {
    if (!modFeedback) return;
    modFeedback.textContent = msg;
    modFeedback.classList.toggle('ok', ok);
    modFeedback.classList.toggle('err', !ok);
    modFeedback.hidden = false;
  }

  async function moderate(id: string, action: 'approve' | 'reject', card: HTMLElement) {
    if (!modKey) return;
    card.querySelectorAll('button').forEach(b => (b.disabled = true));
    try {
      const res = await fetch('/api/comments', {
        method: 'PATCH',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ accessKey: modKey.value, id, action }),
      });
      let data: { error?: string } = {};
      try { data = await res.json(); } catch { /* resposta sem JSON */ }
      if (res.ok) {
        card.remove();
        modShowFeedback(action === 'approve'
          ? '✅ Aprovado — aparece no post em até 1 min (cache de 60s).'
          : '🗑️ Rejeitado — não aparece no site.', true);
        if (modList && modList.childElementCount === 0) {
          modShowFeedback('✅ Fila de comentários zerada!', true);
        }
      } else {
        modShowFeedback(`❌ ${data.error || `Erro ${res.status}`}`, false);
        card.querySelectorAll('button').forEach(b => (b.disabled = false));
      }
    } catch {
      modShowFeedback('❌ Falha de rede — tente de novo.', false);
      card.querySelectorAll('button').forEach(b => (b.disabled = false));
    }
  }

  interface PendingComment {
    id: string;
    page_slug: string;
    locale: string;
    author_name: string;
    body: string;
    created_at: string;
  }

  function renderPending(items: PendingComment[]) {
    if (!modList) return;
    modList.textContent = '';
    for (const c of items) {
      const card = document.createElement('article');
      card.className = 'cm-mod-card';

      const head = document.createElement('div');
      head.className = 'cm-mod-head';
      const name = document.createElement('strong');
      name.textContent = c.author_name;
      const meta = document.createElement('span');
      meta.className = 'time';
      const when = new Date(c.created_at);
      meta.textContent = `${c.locale} · ${c.page_slug} · ${isNaN(when.getTime()) ? '' : when.toLocaleString('pt-PT', { timeZone: 'Europe/Lisbon' })}`;
      head.append(name, meta);

      const body = document.createElement('p');
      body.className = 'cm-mod-body';
      body.textContent = c.body;

      const actions = document.createElement('div');
      actions.className = 'cm-mod-actions';
      const ok = document.createElement('button');
      ok.type = 'button';
      ok.className = 'cm-mod-approve';
      ok.textContent = '✅ Aprovar';
      ok.addEventListener('click', () => moderate(c.id, 'approve', card));
      const no = document.createElement('button');
      no.type = 'button';
      no.className = 'cm-mod-reject';
      no.textContent = '🗑️ Rejeitar';
      no.addEventListener('click', () => moderate(c.id, 'reject', card));
      actions.append(ok, no);

      card.append(head, body, actions);
      modList.appendChild(card);
    }
  }

  if (modForm) {
    modForm.addEventListener('submit', async (ev) => {
      ev.preventDefault();
      if (!modKey?.value || !modBtn) return;
      modBtn.disabled = true;
      modBtn.textContent = 'Carregando...';
      try {
        const res = await fetch(`/api/comments?pending=1&accessKey=${encodeURIComponent(modKey.value)}`);
        let data: { pending?: PendingComment[]; error?: string } = {};
        try { data = await res.json(); } catch { /* resposta sem JSON */ }
        if (res.ok) {
          const items = Array.isArray(data.pending) ? data.pending : [];
          renderPending(items);
          modShowFeedback(items.length === 0
            ? '✅ Nenhum comentário pendente.'
            : `📥 ${items.length} comentário(s) aguardando moderação.`, true);
        } else {
          modShowFeedback(`❌ ${data.error || `Erro ${res.status}`}`, false);
        }
      } catch {
        modShowFeedback('❌ Falha de rede — verifique a conexão e tente de novo.', false);
      } finally {
        modBtn.disabled = false;
        modBtn.textContent = 'Carregar pendentes';
      }
    });
  }
</script>

