---
import BaseLayout from '@layouts/BaseLayout.astro';
import Header from '@components/header/Header.astro';
import Footer from '@components/footer/Footer.astro';
import InlineAppCTA from '@components/banners/InlineAppCTA.astro';
import SchemaBreadcrumb from '@components/seo/SchemaBreadcrumb.astro';
import Amortizacao from '@components/ferramentas/Amortizacao.astro';
import CodigoEmbed from '@components/ferramentas/CodigoEmbed.astro';
import { canonicalPath } from '@/utils/url';

const breadcrumbItems = [
  { name: 'Início', url: '/' },
  { name: 'Ferramentas', url: '/ferramentas' },
  { name: 'Simulador de Amortização', url: '/ferramentas/simulador-amortizacao' }
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "É melhor amortizar reduzindo o prazo ou a parcela?",
      "acceptedAnswer": { "@type": "Answer", "text": "Na maioria dos casos, reduzir o prazo economiza bem mais juros, porque corta as últimas parcelas do contrato, que são as que ainda pagariam juros por mais tempo. Reduzir a parcela alivia o orçamento no mês, mas mantém a dívida até o fim do prazo original." }
    },
    {
      "@type": "Question",
      "name": "Por que o banco oferece primeiro a redução da parcela?",
      "acceptedAnswer": { "@type": "Answer", "text": "Porque é a opção que mais alivia o orçamento imediato do cliente, e também a que mantém o contrato rendendo juros por mais tempo. A escolha é sua: por lei você pode pedir a redução do prazo." }
    },
    {
      "@type": "Question",
      "name": "Vale a pena amortizar o financiamento?",
      "acceptedAnswer": { "@type": "Answer", "text": "Compare o quanto cada real amortizado evita de juros com o que esse mesmo dinheiro renderia investido. Se a taxa do contrato for maior do que o rendimento líquido do investimento, amortizar costuma valer a pena." }
    },
    {
      "@type": "Question",
      "name": "Amortizar reduz o saldo devedor ou as parcelas futuras?",
      "acceptedAnswer": { "@type": "Answer", "text": "A amortização abate diretamente o saldo devedor. A partir daí, você escolhe se o contrato encurta (menos parcelas, mesma parcela) ou se a parcela diminui (mesmo prazo, parcela menor)." }
    }
  ]
};
---

<BaseLayout
  title="Simulador de Amortização: Reduzir Prazo ou Parcela?"
  description="Descubra quanto você economiza amortizando o financiamento, e veja lado a lado a diferença entre reduzir o prazo e reduzir a parcela."
  keywords={['simulador de amortização', 'amortizar financiamento', 'reduzir prazo ou parcela', 'vale a pena amortizar', 'quitar financiamento antes']}
>
  <SchemaBreadcrumb items={breadcrumbItems} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <Header />

  <main class="tool-page" data-pagefind-body>
    <div class="container">
      <header class="tool-header">
        <nav class="tool-breadcrumb">
          <a href="/">Início</a> → <a href={canonicalPath('/ferramentas')}>Ferramentas</a> → <span>Amortização</span>
        </nav>
        <span class="fm-formula">reduzir prazo ≠ reduzir parcela</span>
        <h1>Simulador de Amortização</h1>
        <p class="tool-subtitle">Quanto você economiza amortizando — e a diferença, em reais, entre encurtar o contrato e aliviar a parcela.</p>
      </header>

      <Amortizacao />

      <InlineAppCTA variant="full" locale="pt" />

      <section class="tool-faq">
        <h2>Perguntas Frequentes</h2>
        <details>
          <summary>É melhor reduzir o prazo ou a parcela?</summary>
          <p>Na maioria dos casos, <strong>reduzir o prazo</strong> economiza bem mais juros: corta as últimas parcelas, que são as que ainda pagariam juros por mais tempo. Reduzir a parcela alivia o mês, mas mantém a dívida até o fim do prazo original.</p>
        </details>
        <details>
          <summary>Por que o banco oferece primeiro a redução da parcela?</summary>
          <p>Porque é o que mais alivia o orçamento imediato — e também o que mantém o contrato rendendo juros por mais tempo. <strong>A escolha é sua</strong>: você pode pedir a redução do prazo.</p>
        </details>
        <details>
          <summary>Vale a pena amortizar?</summary>
          <p>Compare quanto cada real amortizado evita de juros com o que esse dinheiro renderia investido. Se a taxa do contrato for maior que o rendimento líquido do investimento, amortizar costuma valer a pena. A calculadora mostra esse retorno por real.</p>
        </details>
        <details>
          <summary>A amortização abate o quê?</summary>
          <p>Abate direto o <strong>saldo devedor</strong>. Depois disso você escolhe: contrato mais curto (mesma parcela) ou parcela menor (mesmo prazo).</p>
        </details>
      </section>

      <CodigoEmbed titulo="Simulador de Amortização" slug="simulador-amortizacao" altura={980} />
    </div>
  </main>

  <Footer />
</BaseLayout>

<style>
  .tool-page { padding: 2rem 0 4rem; }
  .tool-header { margin-bottom: 2rem; }
  .tool-breadcrumb { font-size: 0.8rem; color: var(--text-tertiary); margin-bottom: 1rem; }
  .tool-breadcrumb a { color: var(--text-link); text-decoration: none; }
  .tool-header h1 { color: var(--text-primary); font-size: 2rem; margin-bottom: 0.5rem; letter-spacing: -0.025em; }
  .tool-subtitle { color: var(--text-secondary); font-size: 1rem; }
  .tool-faq { margin-top: 2rem; }
  .tool-faq h2 { color: var(--text-primary); font-size: 1.4rem; margin-bottom: 1rem; }
  .tool-faq details { background: var(--bg-secondary); border: 1px solid var(--border-default); border-radius: 8px; margin-bottom: 0.5rem; padding: 1rem; }
  .tool-faq summary { color: var(--text-primary); font-weight: 600; cursor: pointer; font-size: 0.95rem; }
  .tool-faq details p { color: var(--text-secondary); margin-top: 0.75rem; line-height: 1.6; font-size: 0.9rem; }
</style>
