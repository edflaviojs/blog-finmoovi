---
import BaseLayout from '@layouts/BaseLayout.astro';
import Header from '@components/header/Header.astro';
import Footer from '@components/footer/Footer.astro';
import InlineAppCTA from '@components/banners/InlineAppCTA.astro';
import SchemaBreadcrumb from '@components/seo/SchemaBreadcrumb.astro';
import Reserva from '@components/ferramentas/Reserva.astro';
import CodigoEmbed from '@components/ferramentas/CodigoEmbed.astro';
import { canonicalPath } from '@/utils/url';

const breadcrumbItems = [
  { name: 'Início', url: '/' },
  { name: 'Ferramentas', url: '/ferramentas' },
  { name: 'Calculadora de Reserva de Emergência', url: '/ferramentas/calculadora-reserva' }
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Quanto devo ter na reserva de emergência?",
      "acceptedAnswer": { "@type": "Answer", "text": "Entre 3 e 12 meses de gastos essenciais, dependendo de como você recebe. Quem tem carteira assinada pode ficar entre 3 e 6 meses; autônomos e empreendedores precisam de 6 a 12 meses, porque a renda é menos previsível." }
    },
    {
      "@type": "Question",
      "name": "Por quantos meses minha reserva atual me protege?",
      "acceptedAnswer": { "@type": "Answer", "text": "Divida o valor que você já tem guardado pelos seus gastos essenciais mensais. O resultado é quantos meses você aguenta sem receber nada. É esse número, e não o valor em reais, que mostra o tamanho real da sua proteção." }
    },
    {
      "@type": "Question",
      "name": "Onde guardar a reserva de emergência?",
      "acceptedAnswer": { "@type": "Answer", "text": "Em aplicações de alta liquidez e baixo risco: CDB com liquidez diária, Tesouro Selic ou conta remunerada. O essencial é poder sacar a qualquer momento sem perder dinheiro." }
    },
    {
      "@type": "Question",
      "name": "Reserva de emergência e poupança são a mesma coisa?",
      "acceptedAnswer": { "@type": "Answer", "text": "Não. A poupança costuma render menos que outras aplicações de liquidez diária. A reserva deve estar onde renda perto de 100% do CDI com resgate imediato." }
    },
    {
      "@type": "Question",
      "name": "Posso investir a reserva de emergência?",
      "acceptedAnswer": { "@type": "Answer", "text": "Não em ativos de risco. A reserva existe para emergências (desemprego, doença, conserto urgente) e precisa estar disponível no dia em que a emergência acontecer. Investimentos de maior risco vêm depois que ela estiver completa." }
    }
  ]
};
---

<BaseLayout
  title="Calculadora de Reserva de Emergência Grátis"
  description="Descubra quanto precisa na sua reserva de emergência, por quantos meses você já está protegido e em quanto tempo chega à meta."
  keywords={['calculadora reserva de emergência', 'quanto guardar reserva', 'fundo de emergência', 'segurança financeira', 'quantos meses de reserva']}
>
  <SchemaBreadcrumb items={breadcrumbItems} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <Header />

  <main class="tool-page" data-pagefind-body>
    <div class="container">
      <header class="tool-header">
        <nav class="tool-breadcrumb">
          <a href="/">Início</a> → <a href={canonicalPath('/ferramentas')}>Ferramentas</a> → <span>Reserva de Emergência</span>
        </nav>
        <span class="fm-formula">reserva = gastos essenciais × meses de sossego</span>
        <h1>Calculadora de Reserva de Emergência</h1>
        <p class="tool-subtitle">Quanto guardar, por quantos meses você já está protegido hoje, e em quanto tempo chega à meta.</p>
      </header>

      <Reserva />

      <InlineAppCTA variant="full" locale="pt" />

      <section class="tool-faq">
        <h2>Perguntas Frequentes</h2>
        <details>
          <summary>Quanto devo ter na reserva?</summary>
          <p>Entre <strong>3 e 12 meses</strong> de gastos essenciais, conforme você recebe. Carteira assinada: 3 a 6 meses. Autônomo ou empreendedor: 6 a 12, porque a renda é menos previsível.</p>
        </details>
        <details>
          <summary>Por quantos meses minha reserva me protege?</summary>
          <p>Divida o que você tem guardado pelos gastos essenciais do mês. <strong>É esse número — e não o valor em reais — que mostra o tamanho da sua proteção.</strong> A calculadora faz essa conta no topo.</p>
        </details>
        <details>
          <summary>Onde guardar?</summary>
          <p>Onde dê para sacar hoje sem perder dinheiro: <strong>CDB de liquidez diária</strong>, <strong>Tesouro Selic</strong> ou conta remunerada com taxa conhecida.</p>
        </details>
        <details>
          <summary>Reserva e poupança são a mesma coisa?</summary>
          <p>Não. A poupança costuma render menos que outras aplicações de liquidez diária. A reserva deve render perto de <strong>100% do CDI</strong> com resgate imediato.</p>
        </details>
        <details>
          <summary>Posso investir a reserva?</summary>
          <p>Não em ativos de risco. Ela precisa estar disponível <strong>no dia</strong> em que a emergência acontecer. Risco maior vem depois que ela estiver completa.</p>
        </details>
      </section>

      <CodigoEmbed titulo="Calculadora de Reserva de Emergência" slug="calculadora-reserva" altura={900} />
    </div>
  </main>

  <Footer />
</BaseLayout>

<style>
  .tool-page { padding: 2rem 0 4rem; }
  .tool-header { margin-bottom: 2rem; }
  .tool-breadcrumb { font-size: 0.8rem; color: var(--text-tertiary); margin-bottom: 1rem; }
  .tool-breadcrumb a { color: var(--text-link); text-decoration: none; }
  .tool-header h1 { color: var(--text-primary); font-size: 2rem; margin-bottom: 0.5rem; letter-spacing: -0.025em; }
  .tool-subtitle { color: var(--text-secondary); font-size: 1rem; }
  .tool-faq { margin-top: 2rem; }
  .tool-faq h2 { color: var(--text-primary); font-size: 1.4rem; margin-bottom: 1rem; }
  .tool-faq details { background: var(--bg-secondary); border: 1px solid var(--border-default); border-radius: 8px; margin-bottom: 0.5rem; padding: 1rem; }
  .tool-faq summary { color: var(--text-primary); font-weight: 600; cursor: pointer; font-size: 0.95rem; }
  .tool-faq details p { color: var(--text-secondary); margin-top: 0.75rem; line-height: 1.6; font-size: 0.9rem; }
</style>
