---
import BaseLayout from '@layouts/BaseLayout.astro';
import Header from '@components/header/Header.astro';
import Footer from '@components/footer/Footer.astro';
import InlineAppCTA from '@components/banners/InlineAppCTA.astro';
import SchemaBreadcrumb from '@components/seo/SchemaBreadcrumb.astro';
import ConversorMoedas from '@components/ferramentas/ConversorMoedas.astro';
import CodigoEmbed from '@components/ferramentas/CodigoEmbed.astro';
import { canonicalPath } from '@/utils/url';

const breadcrumbItems = [
  { name: 'Início', url: '/' },
  { name: 'Ferramentas', url: '/ferramentas' },
  { name: 'Conversor de Moedas', url: '/ferramentas/conversor-moedas' }
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "De onde vêm as cotações?",
      "acceptedAnswer": { "@type": "Answer", "text": "Da AwesomeAPI, a mesma fonte do ticker no topo do blog. O valor mostrado é a taxa comercial, que é a referência do mercado." }
    },
    {
      "@type": "Question",
      "name": "Por que o valor do banco é diferente?",
      "acceptedAnswer": { "@type": "Answer", "text": "Porque bancos e casas de câmbio aplicam spread e tarifas sobre a taxa comercial, além do IOF quando aplicável. A taxa comercial serve como referência para comparar propostas, não como o valor final da operação." }
    },
    {
      "@type": "Question",
      "name": "De quanto em quanto tempo a cotação é atualizada?",
      "acceptedAnswer": { "@type": "Answer", "text": "A cada vez que a página é aberta. Em dia útil reflete o mercado no momento; no fim de semana mostra o fechamento da sexta-feira." }
    },
    {
      "@type": "Question",
      "name": "Posso usar essa taxa para transferência internacional?",
      "acceptedAnswer": { "@type": "Answer", "text": "Como referência, sim. O valor final depende do spread e das tarifas do serviço que você usar, por isso compare a proposta recebida com a taxa comercial mostrada aqui." }
    }
  ]
};
---

<BaseLayout
  title="Conversor de Moedas Online Grátis - Cotação em Tempo Real"
  description="Converta entre real, dólar, euro e outras moedas com cotação atualizada e a variação do dia. Grátis, sem cadastro."
  keywords={['conversor de moedas', 'cotação do dólar', 'dólar hoje', 'euro hoje', 'converter real em dólar', 'câmbio']}
>
  <SchemaBreadcrumb items={breadcrumbItems} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <Header />

  <main class="tool-page" data-pagefind-body>
    <div class="container">
      <header class="tool-header">
        <nav class="tool-breadcrumb">
          <a href="/">Início</a> → <a href={canonicalPath('/ferramentas')}>Ferramentas</a> → <span>Conversor de Moedas</span>
        </nav>
        <span class="fm-formula">taxa comercial · sem o spread do banco</span>
        <h1>Conversor de Moedas</h1>
        <p class="tool-subtitle">Converta com a cotação do momento e veja quanto cada moeda andou hoje contra o real.</p>
      </header>

      <ConversorMoedas />

      <InlineAppCTA variant="full" locale="pt" />

      <section class="tool-faq">
        <h2>Perguntas Frequentes</h2>
        <details>
          <summary>De onde vêm as cotações?</summary>
          <p>Da <strong>AwesomeAPI</strong>, a mesma fonte do ticker no topo do blog. O valor é a <strong>taxa comercial</strong>, a referência do mercado.</p>
        </details>
        <details>
          <summary>Por que o valor do meu banco é diferente?</summary>
          <p>Porque bancos e casas de câmbio somam <strong>spread</strong>, tarifas e IOF sobre a taxa comercial. Use o valor daqui para comparar propostas, não como preço final.</p>
        </details>
        <details>
          <summary>De quanto em quanto tempo atualiza?</summary>
          <p>A cada vez que você abre a página. Em dia útil reflete o mercado no momento; no fim de semana mostra o fechamento de sexta.</p>
        </details>
        <details>
          <summary>Serve para transferência internacional?</summary>
          <p>Como <strong>referência</strong>. O valor final depende do spread e das tarifas do serviço — compare a proposta recebida com a taxa mostrada aqui.</p>
        </details>
      </section>

      <CodigoEmbed titulo="Conversor de Moedas" slug="conversor-moedas" altura={720} />
    </div>
  </main>

  <Footer />
</BaseLayout>

<style>
  .tool-page { padding: 2rem 0 4rem; }
  .tool-header { margin-bottom: 2rem; }
  .tool-breadcrumb { font-size: 0.8rem; color: var(--text-tertiary); margin-bottom: 1rem; }
  .tool-breadcrumb a { color: var(--text-link); text-decoration: none; }
  .tool-header h1 { color: var(--text-primary); font-size: 2rem; margin-bottom: 0.5rem; letter-spacing: -0.025em; }
  .tool-subtitle { color: var(--text-secondary); font-size: 1rem; }
  .tool-faq { margin-top: 2rem; }
  .tool-faq h2 { color: var(--text-primary); font-size: 1.4rem; margin-bottom: 1rem; }
  .tool-faq details { background: var(--bg-secondary); border: 1px solid var(--border-default); border-radius: 8px; margin-bottom: 0.5rem; padding: 1rem; }
  .tool-faq summary { color: var(--text-primary); font-weight: 600; cursor: pointer; font-size: 0.95rem; }
  .tool-faq details p { color: var(--text-secondary); margin-top: 0.75rem; line-height: 1.6; font-size: 0.9rem; }
</style>
