---
import BaseLayout from '@layouts/BaseLayout.astro';
import Header from '@components/header/Header.astro';
import Footer from '@components/footer/Footer.astro';
import InlineAppCTA from '@components/banners/InlineAppCTA.astro';
import SchemaBreadcrumb from '@components/seo/SchemaBreadcrumb.astro';
import RacharConta from '@components/ferramentas/RacharConta.astro';
import CodigoEmbed from '@components/ferramentas/CodigoEmbed.astro';
import { canonicalPath } from '@/utils/url';

const breadcrumbItems = [
  { name: 'Início', url: '/' },
  { name: 'Ferramentas', url: '/ferramentas' },
  { name: 'Rachar a Conta', url: '/ferramentas/rachar-conta' }
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Como dividir a conta quando nem todos beberam?",
      "acceptedAnswer": { "@type": "Answer", "text": "Separe o valor das bebidas do restante. A comida é dividida por todas as pessoas da mesa e a bebida apenas entre quem bebeu. Assim quem não bebeu não paga a bebida dos outros." }
    },
    {
      "@type": "Question",
      "name": "A gorjeta de 10% é obrigatória?",
      "acceptedAnswer": { "@type": "Answer", "text": "Não. No Brasil a taxa de serviço é opcional e o cliente pode pedir a retirada. Quando é paga, o valor costuma ser 10% sobre o consumo e entra na divisão da mesma forma que o restante da conta." }
    },
    {
      "@type": "Question",
      "name": "Como calcular o valor por pessoa com gorjeta?",
      "acceptedAnswer": { "@type": "Answer", "text": "Multiplique o total da conta pelo percentual da gorjeta somado a 1 e divida pelo número de pessoas. Com 10% de gorjeta e 4 pessoas numa conta de R$ 300: 300 × 1,10 ÷ 4 = R$ 82,50 por pessoa." }
    },
    {
      "@type": "Question",
      "name": "O que fazer com o troco quando cada um coloca uma nota redonda?",
      "acceptedAnswer": { "@type": "Answer", "text": "O valor que sobra costuma ir para a gorjeta. A calculadora mostra quanto sobra quando todos arredondam para cima, para a mesa decidir de forma consciente em vez de deixar no acaso." }
    }
  ]
};
---

<BaseLayout
  title="Rachar a Conta: Calculadora Grátis com Gorjeta"
  description="Divida a conta do restaurante com gorjeta, separando a bebida de quem bebeu. Veja quanto cada um paga e quanto sobra de troco."
  keywords={['rachar a conta', 'dividir conta restaurante', 'calculadora gorjeta', 'dividir conta por pessoa', 'quanto cada um paga']}
>
  <SchemaBreadcrumb items={breadcrumbItems} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <Header />

  <main class="tool-page" data-pagefind-body>
    <div class="container">
      <header class="tool-header">
        <nav class="tool-breadcrumb">
          <a href="/">Início</a> → <a href={canonicalPath('/ferramentas')}>Ferramentas</a> → <span>Rachar a Conta</span>
        </nav>
        <span class="fm-formula">comida ÷ todos &nbsp;+&nbsp; bebida ÷ quem bebeu</span>
        <h1>Rachar a Conta</h1>
        <p class="tool-subtitle">Quanto cada um paga, com gorjeta — e sem quem não bebeu pagar a bebida dos outros.</p>
      </header>

      <RacharConta />

      <InlineAppCTA variant="full" locale="pt" />

      <section class="tool-faq">
        <h2>Perguntas Frequentes</h2>
        <details>
          <summary>Como dividir quando nem todos beberam?</summary>
          <p>Separe o valor das bebidas. A <strong>comida divide por todos</strong>; a <strong>bebida, só por quem bebeu</strong>. A calculadora mostra os dois valores e quanto quem não bebeu pagaria a mais na divisão simples.</p>
        </details>
        <details>
          <summary>A gorjeta de 10% é obrigatória?</summary>
          <p>Não. A taxa de serviço é <strong>opcional</strong> e você pode pedir a retirada. Quando paga, costuma ser 10% do consumo e entra na divisão como o resto da conta.</p>
        </details>
        <details>
          <summary>Como calcular por pessoa com gorjeta?</summary>
          <p>Total × 1,10 ÷ número de pessoas. Numa conta de R$ 300 com 4 pessoas: <strong>R$ 82,50</strong> cada.</p>
        </details>
        <details>
          <summary>E o troco, quando todos arredondam?</summary>
          <p>O que sobra costuma virar gorjeta. A calculadora mostra <strong>quanto sobra</strong> quando cada um põe nota redonda, para a mesa decidir em vez de deixar ao acaso.</p>
        </details>
      </section>

      <CodigoEmbed titulo="Calculadora de Rachar a Conta" slug="rachar-conta" altura={860} />
    </div>
  </main>

  <Footer />
</BaseLayout>

<style>
  .tool-page { padding: 2rem 0 4rem; }
  .tool-header { margin-bottom: 2rem; }
  .tool-breadcrumb { font-size: 0.8rem; color: var(--text-tertiary); margin-bottom: 1rem; }
  .tool-breadcrumb a { color: var(--text-link); text-decoration: none; }
  .tool-header h1 { color: var(--text-primary); font-size: 2rem; margin-bottom: 0.5rem; letter-spacing: -0.025em; }
  .tool-subtitle { color: var(--text-secondary); font-size: 1rem; }
  .tool-faq { margin-top: 2rem; }
  .tool-faq h2 { color: var(--text-primary); font-size: 1.4rem; margin-bottom: 1rem; }
  .tool-faq details { background: var(--bg-secondary); border: 1px solid var(--border-default); border-radius: 8px; margin-bottom: 0.5rem; padding: 1rem; }
  .tool-faq summary { color: var(--text-primary); font-weight: 600; cursor: pointer; font-size: 0.95rem; }
  .tool-faq details p { color: var(--text-secondary); margin-top: 0.75rem; line-height: 1.6; font-size: 0.9rem; }
</style>
