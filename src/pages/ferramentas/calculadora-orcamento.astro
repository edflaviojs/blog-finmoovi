---
import BaseLayout from '@layouts/BaseLayout.astro';
import Header from '@components/header/Header.astro';
import Footer from '@components/footer/Footer.astro';
import InlineAppCTA from '@components/banners/InlineAppCTA.astro';
import SchemaBreadcrumb from '@components/seo/SchemaBreadcrumb.astro';
import Orcamento from '@components/ferramentas/Orcamento.astro';
import CodigoEmbed from '@components/ferramentas/CodigoEmbed.astro';
import { canonicalPath } from '@/utils/url';

const breadcrumbItems = [
  { name: 'Início', url: '/' },
  { name: 'Ferramentas', url: '/ferramentas' },
  { name: 'Calculadora de Orçamento 50-30-20', url: '/ferramentas/calculadora-orcamento' }
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "O que é a regra 50-30-20?",
      "acceptedAnswer": { "@type": "Answer", "text": "A regra 50-30-20 divide sua renda líquida em 3 partes: 50% para necessidades (aluguel, contas, alimentação, transporte), 30% para desejos (lazer, compras, assinaturas) e 20% para você (reserva, investimentos, quitar dívidas)." }
    },
    {
      "@type": "Question",
      "name": "E se minhas necessidades passam de 50% da renda?",
      "acceptedAnswer": { "@type": "Answer", "text": "É comum e não invalida a regra. Nesse caso a regra vira um diagnóstico: mostra exatamente quanto você passou do limite. O caminho é reduzir os desejos temporariamente ou atacar o maior gasto fixo, normalmente moradia ou transporte." }
    },
    {
      "@type": "Question",
      "name": "Devo usar o salário bruto ou o líquido?",
      "acceptedAnswer": { "@type": "Answer", "text": "Sempre o líquido, ou seja, o valor que realmente cai na conta. INSS, Imposto de Renda e outros descontos já saíram antes de chegar a você e não estão disponíveis para o orçamento." }
    },
    {
      "@type": "Question",
      "name": "No que os 20% se transformam com o tempo?",
      "acceptedAnswer": { "@type": "Answer", "text": "Depende da rentabilidade. Guardando 20% de uma renda de R$ 5.000 (R$ 1.000 por mês) a 1% ao mês, em 10 anos o montante passa de R$ 230 mil, sendo mais de R$ 110 mil vindos apenas dos juros." }
    }
  ]
};
---

<BaseLayout
  title="Calculadora de Orçamento 50-30-20 Grátis"
  description="Monte seu orçamento pessoal usando a regra 50-30-20. Veja quanto pode gastar em cada área, se você passou do limite e no que os 20% se transformam."
  keywords={['regra 50-30-20', 'calculadora orçamento', 'orçamento pessoal', 'como dividir salário', 'planejamento financeiro']}
>
  <SchemaBreadcrumb items={breadcrumbItems} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <Header />

  <main class="tool-page" data-pagefind-body>
    <div class="container">
      <header class="tool-header">
        <nav class="tool-breadcrumb">
          <a href="/">Início</a> → <a href={canonicalPath('/ferramentas')}>Ferramentas</a> → <span>Orçamento 50-30-20</span>
        </nav>
        <span class="fm-formula">50% necessidades · 30% desejos · 20% você</span>
        <h1>Calculadora de Orçamento 50-30-20</h1>
        <p class="tool-subtitle">Quanto pode ir para cada área do seu mês — e se o que você gasta hoje cabe dentro do limite.</p>
      </header>

      <Orcamento />

      <InlineAppCTA variant="full" locale="pt" />

      <section class="tool-faq">
        <h2>Perguntas Frequentes</h2>
        <details>
          <summary>O que é a regra 50-30-20?</summary>
          <p>Divide a renda líquida em três: <strong>50%</strong> para necessidades (aluguel, contas, alimentação, transporte), <strong>30%</strong> para desejos (lazer, compras, assinaturas) e <strong>20%</strong> para você (reserva, investimentos, quitar dívidas).</p>
        </details>
        <details>
          <summary>E se minhas necessidades passam de 50%?</summary>
          <p>É comum, e não invalida a regra — vira <strong>diagnóstico</strong>. A calculadora mostra exatamente quanto você passou. O caminho é reduzir desejos por um tempo ou atacar o maior gasto fixo, quase sempre moradia ou transporte.</p>
        </details>
        <details>
          <summary>Salário bruto ou líquido?</summary>
          <p>Sempre o <strong>líquido</strong>, o que cai na conta. INSS e Imposto de Renda já saíram antes e não estão disponíveis para o seu orçamento.</p>
        </details>
        <details>
          <summary>No que os 20% se transformam?</summary>
          <p>Guardando <strong>R$ 1.000 por mês a 1% ao mês</strong>, em 10 anos o montante passa de R$ 230 mil — e mais de R$ 110 mil disso vêm só dos juros. A calculadora refaz essa conta com o seu valor.</p>
        </details>
      </section>

      <CodigoEmbed titulo="Calculadora de Orçamento 50-30-20" slug="calculadora-orcamento" altura={780} />
    </div>
  </main>

  <Footer />
</BaseLayout>

<style>
  .tool-page { padding: 2rem 0 4rem; }
  .tool-header { margin-bottom: 2rem; }
  .tool-breadcrumb { font-size: 0.8rem; color: var(--text-tertiary); margin-bottom: 1rem; }
  .tool-breadcrumb a { color: var(--text-link); text-decoration: none; }
  .tool-header h1 { color: var(--text-primary); font-size: 2rem; margin-bottom: 0.5rem; letter-spacing: -0.025em; }
  .tool-subtitle { color: var(--text-secondary); font-size: 1rem; }
  .tool-faq { margin-top: 2rem; }
  .tool-faq h2 { color: var(--text-primary); font-size: 1.4rem; margin-bottom: 1rem; }
  .tool-faq details { background: var(--bg-secondary); border: 1px solid var(--border-default); border-radius: 8px; margin-bottom: 0.5rem; padding: 1rem; }
  .tool-faq summary { color: var(--text-primary); font-weight: 600; cursor: pointer; font-size: 0.95rem; }
  .tool-faq details p { color: var(--text-secondary); margin-top: 0.75rem; line-height: 1.6; font-size: 0.9rem; }
</style>
