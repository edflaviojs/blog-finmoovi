---
import BaseLayout from '@layouts/BaseLayout.astro';
import Header from '@components/header/Header.astro';
import Footer from '@components/footer/Footer.astro';
import InlineAppCTA from '@components/banners/InlineAppCTA.astro';
import SchemaBreadcrumb from '@components/seo/SchemaBreadcrumb.astro';
import SimuladorInvestimento from '@components/ferramentas/SimuladorInvestimento.astro';
import CodigoEmbed from '@components/ferramentas/CodigoEmbed.astro';
import { canonicalPath } from '@/utils/url';

const breadcrumbItems = [
  { name: 'Início', url: '/' },
  { name: 'Ferramentas', url: '/ferramentas' },
  { name: 'Simulador de Investimento', url: '/ferramentas/simulador-investimento' }
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Quanto preciso investir por mês para ter 1 milhão?",
      "acceptedAnswer": { "@type": "Answer", "text": "Depende do prazo e da rentabilidade. A 1% ao mês, investindo cerca de R$ 1.500 por mês, chega-se a R$ 1 milhão em aproximadamente 20 anos. Com R$ 3.000 por mês, o prazo cai para cerca de 13 anos." }
    },
    {
      "@type": "Question",
      "name": "Por que esperar mais tempo reduz tanto o aporte mensal?",
      "acceptedAnswer": { "@type": "Answer", "text": "Porque os juros compostos crescem de forma exponencial com o tempo. Cada ano a mais aumenta a parcela do objetivo que é paga pelos juros e não pelo seu bolso, o que derruba o valor que você precisa depositar todo mês." }
    },
    {
      "@type": "Question",
      "name": "Qual rendimento usar na simulação?",
      "acceptedAnswer": { "@type": "Answer", "text": "Como referência: perfil conservador em torno de 0,7% ao mês, moderado em torno de 1% ao mês e arrojado acima disso. São referências de planejamento, não promessas de retorno." }
    },
    {
      "@type": "Question",
      "name": "O resultado é garantido?",
      "acceptedAnswer": { "@type": "Answer", "text": "Não. A simulação usa uma taxa fixa, e na prática os investimentos oscilam. Serve para definir a meta e comparar cenários, não como certeza de resultado." }
    }
  ]
};
---

<BaseLayout
  title="Simulador de Investimento Grátis - Quanto Investir por Mês"
  description="Descubra quanto precisa investir por mês para alcançar seu objetivo, e quanto o aporte cai se você der mais tempo ao dinheiro."
  keywords={['simulador de investimento', 'quanto investir por mês', 'calculadora objetivo financeiro', 'quanto preciso para 1 milhão', 'planejar investimento']}
>
  <SchemaBreadcrumb items={breadcrumbItems} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <Header />

  <main class="tool-page" data-pagefind-body>
    <div class="container">
      <header class="tool-header">
        <nav class="tool-breadcrumb">
          <a href="/">Início</a> → <a href={canonicalPath('/ferramentas')}>Ferramentas</a> → <span>Simulador de Investimento</span>
        </nav>
        <span class="fm-formula">aporte = (objetivo − inicial·(1+i)<sup>n</sup>) ÷ [((1+i)<sup>n</sup> − 1) ÷ i]</span>
        <h1>Simulador de Investimento</h1>
        <p class="tool-subtitle">A conta ao contrário: você diz aonde quer chegar, e ela diz quanto precisa pôr por mês.</p>
      </header>

      <SimuladorInvestimento />

      <InlineAppCTA variant="full" locale="pt" />

      <section class="tool-faq">
        <h2>Perguntas Frequentes</h2>
        <details>
          <summary>Quanto preciso investir por mês para ter 1 milhão?</summary>
          <p>Depende do prazo e da rentabilidade. A 1% ao mês, com cerca de <strong>R$ 1.500/mês</strong> chega-se a R$ 1 milhão em aproximadamente 20 anos. Com R$ 3.000/mês, em cerca de 13.</p>
        </details>
        <details>
          <summary>Por que esperar mais tempo derruba tanto o aporte?</summary>
          <p>Porque os juros crescem de forma exponencial. Cada ano a mais aumenta a fatia do objetivo paga <strong>pelos juros</strong> e não pelo seu bolso. A calculadora mostra essa queda em percentagem.</p>
        </details>
        <details>
          <summary>Qual rendimento usar?</summary>
          <p>Como referência: <strong>conservador</strong> perto de 0,7% ao mês, <strong>moderado</strong> perto de 1%, <strong>arrojado</strong> acima disso. São referências de planejamento, não promessas.</p>
        </details>
        <details>
          <summary>O resultado é garantido?</summary>
          <p>Não. A simulação usa taxa fixa e a realidade oscila. Serve para definir meta e comparar cenários — não como certeza.</p>
        </details>
      </section>

      <CodigoEmbed titulo="Simulador de Investimento" slug="simulador-investimento" altura={900} />
    </div>
  </main>

  <Footer />
</BaseLayout>

<style>
  .tool-page { padding: 2rem 0 4rem; }
  .tool-header { margin-bottom: 2rem; }
  .tool-breadcrumb { font-size: 0.8rem; color: var(--text-tertiary); margin-bottom: 1rem; }
  .tool-breadcrumb a { color: var(--text-link); text-decoration: none; }
  .tool-header h1 { color: var(--text-primary); font-size: 2rem; margin-bottom: 0.5rem; letter-spacing: -0.025em; }
  .tool-subtitle { color: var(--text-secondary); font-size: 1rem; }
  .tool-faq { margin-top: 2rem; }
  .tool-faq h2 { color: var(--text-primary); font-size: 1.4rem; margin-bottom: 1rem; }
  .tool-faq details { background: var(--bg-secondary); border: 1px solid var(--border-default); border-radius: 8px; margin-bottom: 0.5rem; padding: 1rem; }
  .tool-faq summary { color: var(--text-primary); font-weight: 600; cursor: pointer; font-size: 0.95rem; }
  .tool-faq details p { color: var(--text-secondary); margin-top: 0.75rem; line-height: 1.6; font-size: 0.9rem; }
</style>
