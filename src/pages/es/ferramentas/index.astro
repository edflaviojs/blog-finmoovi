---
import BaseLayout from '@layouts/BaseLayout.astro';
import Header from '@components/header/Header.astro';
import Footer from '@components/footer/Footer.astro';
import { canonicalPath } from '@/utils/url';
import { t } from '../../../i18n/translations';

const lang = 'es';
---

<BaseLayout
  title="Herramientas Financieras Gratuitas"
  description="Calculadoras y herramientas gratuitas para organizar tus finanzas. Simulador de interés, conversor de monedas y más."
  keywords={['calculadora financiera', 'simulador interés compuesto', 'conversor monedas', 'herramientas financieras']}
>
  <Header />

  <main class="ferramentas-page">
    <div class="container">
      <header class="ferramentas-header">
        <h1 class="ferramentas-title">{t(lang, 'ferramentas.title')}</h1>
        <p class="ferramentas-description">{t(lang, 'ferramentas.desc')}</p>
        <p class="ferramentas-aviso">{t(lang, 'ferramentas.aviso')}</p>
      </header>

      <div class="ferramentas-grid">
        <a href={canonicalPath('/ferramentas/calculadora-juros-compostos')} class="ferramenta-card active">
          <span class="ferramenta-badge live">{t(lang, 'ferramentas.badge.aberta')}</span>
          <div class="ferramenta-icon">📈</div>
          <h3 class="ferramenta-title">{t(lang, 'ferramentas.juros.title')}</h3>
          <p class="ferramenta-description">{t(lang, 'ferramentas.juros.desc')}</p>
        </a>

        <a href={canonicalPath('/ferramentas/calculadora-orcamento')} class="ferramenta-card active">
          <span class="ferramenta-badge live">{t(lang, 'ferramentas.badge.aberta')}</span>
          <div class="ferramenta-icon">💰</div>
          <h3 class="ferramenta-title">{t(lang, 'ferramentas.orcamento.title')}</h3>
          <p class="ferramenta-description">{t(lang, 'ferramentas.orcamento.desc')}</p>
        </a>

        <a href={canonicalPath('/ferramentas/conversor-moedas')} class="ferramenta-card active">
          <span class="ferramenta-badge live">{t(lang, 'ferramentas.badge.aberta')}</span>
          <div class="ferramenta-icon">💱</div>
          <h3 class="ferramenta-title">{t(lang, 'ferramentas.conversor.title')}</h3>
          <p class="ferramenta-description">{t(lang, 'ferramentas.conversor.desc')}</p>
        </a>

        <a href={canonicalPath('/ferramentas/simulador-investimento')} class="ferramenta-card active">
          <span class="ferramenta-badge live">{t(lang, 'ferramentas.badge.aberta')}</span>
          <div class="ferramenta-icon">🎯</div>
          <h3 class="ferramenta-title">{t(lang, 'ferramentas.simulador.title')}</h3>
          <p class="ferramenta-description">{t(lang, 'ferramentas.simulador.desc')}</p>
        </a>

        <a href={canonicalPath('/ferramentas/calculadora-reserva')} class="ferramenta-card active">
          <span class="ferramenta-badge live">{t(lang, 'ferramentas.badge.aberta')}</span>
          <div class="ferramenta-icon">🛡️</div>
          <h3 class="ferramenta-title">{t(lang, 'ferramentas.emergencia.title')}</h3>
          <p class="ferramenta-description">{t(lang, 'ferramentas.emergencia.desc')}</p>
        </a>

        <a href={canonicalPath('/ferramentas/calculadora-financiamento')} class="ferramenta-card active">
          <span class="ferramenta-badge live">{t(lang, 'ferramentas.badge.aberta')}</span>
          <div class="ferramenta-icon">🏠</div>
          <h3 class="ferramenta-title">{t(lang, 'ferramentas.financiamento.title')}</h3>
          <p class="ferramenta-description">{t(lang, 'ferramentas.financiamento.desc')}</p>
        </a>

        <a href={canonicalPath('/ferramentas/calculadora-aposentadoria')} class="ferramenta-card active">
          <span class="ferramenta-badge live">{t(lang, 'ferramentas.badge.aberta')}</span>
          <div class="ferramenta-icon">🌴</div>
          <h3 class="ferramenta-title">{t(lang, 'ferramentas.aposentadoria.title')}</h3>
          <p class="ferramenta-description">{t(lang, 'ferramentas.aposentadoria.desc')}</p>
        </a>

        <div class="ferramenta-card">
          <span class="ferramenta-badge">{t(lang, 'ferramentas.badge.embreve')}</span>
          <div class="ferramenta-icon">🏦</div>
          <h3 class="ferramenta-title">{t(lang, 'ferramentas.cdb.title')}</h3>
          <p class="ferramenta-description">{t(lang, 'ferramentas.cdb.desc')}</p>
        </div>
      </div>
    </div>
  </main>

  <Footer />
</BaseLayout>

<style>
  .ferramentas-page { padding: var(--space-8) 0 var(--space-16); }
  .ferramentas-header { text-align: center; margin-bottom: var(--space-12); }
  .ferramentas-title { font-size: var(--text-4xl); letter-spacing: -0.02em; background: var(--portal-grad); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text; margin-bottom: var(--space-4); }
  .ferramentas-description { color: var(--text-secondary); font-size: var(--text-lg); max-width: 500px; margin: 0 auto; }
  .ferramentas-aviso { color: var(--text-secondary); font-size: var(--text-sm); max-width: 560px; margin: var(--space-3) auto 0; opacity: 0.8; }
  .ferramentas-grid { display: grid; grid-template-columns: 1fr; gap: var(--space-6); }
  @media (min-width: 640px) { .ferramentas-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1024px) { .ferramentas-grid { grid-template-columns: repeat(3, 1fr); } }
  .ferramenta-card { display: block; padding: var(--space-8); background: var(--bg-secondary); border: 1px solid var(--border-muted); border-radius: var(--radius-lg); box-shadow: var(--shadow-sm); text-decoration: none; transition: transform 0.25s ease, box-shadow 0.25s ease, border-color var(--transition-fast); position: relative; }
  .ferramenta-card:hover { border-color: var(--border-default); transform: translateY(-4px); box-shadow: var(--shadow-lg); }
  .ferramenta-card.active { border-color: #3fb950; cursor: pointer; }
  .ferramenta-card.active:hover { border-color: #3fb950; box-shadow: 0 0 20px rgba(63, 185, 80, 0.2); }
  .ferramenta-badge { position: absolute; top: var(--space-3); right: var(--space-3); padding: 2px var(--space-2); background: rgba(0, 240, 255, 0.1); color: var(--brand-cyan); border-radius: var(--radius-sm); font-size: var(--text-xs); font-weight: 600; }
  .ferramenta-badge.live { background: rgba(63, 185, 80, 0.15); color: #3fb950; }
  .ferramenta-icon { font-size: 2.5rem; margin-bottom: var(--space-4); }
  .ferramenta-title { font-size: var(--text-lg); color: var(--text-primary); margin-bottom: var(--space-3); }
  .ferramenta-description { font-size: var(--text-sm); color: var(--text-secondary); line-height: var(--leading-relaxed); margin-bottom: 0; }
</style>
